# Copy to apps/web/.env.local for the web app, or to .env for the Phase 1 router harness.

# ---- database
DATABASE_URL=postgres://localhost:5432/zca_dev
# Only for `pnpm test:db`. Integration tests skip themselves when this is unset.
TEST_DATABASE_URL=postgres://localhost:5432/zca_dev

# ---- auth (Auth.js v5 naming)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails allowed into /admin. Everyone else gets a 404.
ADMIN_EMAILS=

# ---- key vault
# base64 of 32 random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit this and never store it in the database. Rotating it makes every
# stored provider key unreadable, and users have to add theirs again.
KEY_ENCRYPTION_KEY=

# ---- operator provider keys (the shared demo pool)
MISTRAL_API_KEY=
GROQ_API_KEY=
# Cerebras has no no-card free tier since August 2026; leave empty unless you hold credits.
CEREBRAS_API_KEY=

# ---- router behaviour
FIRST_TOKEN_TIMEOUT_MS=8000
PROVIDER_COOLDOWN_SECONDS=60
DEMO_MESSAGES_PER_ACCOUNT_PER_DAY=10
DEMO_MODEL=auto

# ---- chrome extension
EXTENSION_SESSION_GRACE_DAYS=7

# ---- local stubs, Phase 1 harness only
# MISTRAL_BASE_URL=http://localhost:9001/v1
# GROQ_BASE_URL=http://localhost:9002/v1
PORT=8787
