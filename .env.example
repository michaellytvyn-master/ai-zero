# ---- provider keys (router / demo mode uses these; users bring their own in the extension)
MISTRAL_API_KEY=
GROQ_API_KEY=
# Cerebras no longer has a no-card free tier; leave empty unless you have credits.
CEREBRAS_API_KEY=

# ---- router behaviour
PORT=8787
FIRST_TOKEN_TIMEOUT_MS=8000
PROVIDER_COOLDOWN_SECONDS=60

# ---- demo caps (phase 6)
DEMO_MESSAGES_PER_ACCOUNT_PER_DAY=10
DEMO_MODEL=

# ---- web app: auth, database, admin (phase 6)
DATABASE_URL=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=

# ---- chrome extension session (phase 2)
EXTENSION_SESSION_GRACE_DAYS=7
