# Web app: copy to apps/web/.env.local
# Phase 1 router harness: export these in your shell, or copy to .env

# ---- public identity (SEO)
# The canonical origin. Canonical tags, sitemap.xml, robots.txt and the Open
# Graph card all hang off it. Unset it and they fall back to localhost, which
# is fine in development and wrong in production.
NEXT_PUBLIC_SITE_URL=https://example.com

# ---- database
DATABASE_URL=postgres://localhost:5432/zca_dev
# Only for `pnpm test:db`. The integration suite skips itself when this is unset.
TEST_DATABASE_URL=postgres://localhost:5432/zca_dev

# ---- auth (Auth.js v5 naming)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# OPTIONAL. Email and password work without these; setting them adds Google as
# a second way into the same account.
# Google Cloud Console -> Credentials -> OAuth client ID -> Web application.
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# ---- operator area at /admin, separate from any user account
# Leave empty and there is nothing to sign in to, which is the safe default.
# Sign-in is throttled per caller and asks an arithmetic question each time.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Only when self-hosting behind a proxy or on a non-standard host. Vercel and
# `next dev` work it out on their own; `next start` elsewhere refuses to trust
# the host without this, and every sign-in fails with UntrustedHost.
# AUTH_TRUST_HOST=true

# ---- key vault
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit this and never store it in the database. Rotating it makes every
# stored provider key unreadable, and users have to add theirs again.
KEY_ENCRYPTION_KEY=

# ---- operator provider keys (the shared demo pool)
# Both are free without a credit card. See docs/providers.md.
# https://console.groq.com/keys
GROQ_API_KEY=
# https://dash.cloudflare.com  ->  AI  ->  Workers AI
# The account id is in the dashboard URL; the adapter needs both.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# https://aistudio.google.com/apikey  — free, no card.
# NOTE: on Google's free tier your prompts and replies are used to improve
# Google products and may be read by human reviewers, and their terms say not
# to send sensitive or personal data. Groq and Cloudflare do not do this.
GEMINI_API_KEY=

# ---- generated images (optional; image generation is off without these)
# YOUR account, used only as a shared test pool so visitors can try the feature.
# Everything written here is deleted an hour after it is made, so a free plan is
# plenty. Users who connect their own Cloudinary account in Settings write to
# theirs instead, keep their pictures indefinitely, and never touch this one.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Protects /api/images/cleanup, which the schedule in apps/web/vercel.json calls.
CRON_SECRET=

# ---- router behaviour
# Applies to every account, own keys or not. Provider quotas are per
# organisation, so many users cost nothing — but one runaway client would make
# this server's outbound traffic look abusive to everyone sharing it.
REQUESTS_PER_MINUTE_PER_USER=60

FIRST_TOKEN_TIMEOUT_MS=8000
PROVIDER_COOLDOWN_SECONDS=60
DEMO_MESSAGES_PER_ACCOUNT_PER_DAY=10
DEMO_MODEL=auto

# ---- chrome extension
EXTENSION_SESSION_GRACE_DAYS=7
# Comma-separated extension ids allowed to sign in. Set it once the extension is
# published: without it, any installed extension can open the consent page —
# which looks like this product's — and be handed a token if the user allows.
# List the store id, and your unpacked id for local development. Find both at
# chrome://extensions.
# EXTENSION_IDS=abcdefghijklmnopabcdefghijklmnop

# ---- Phase 1 harness only
# GROQ_BASE_URL=http://localhost:9002/v1
PORT=8787
