{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/node_modules",
      "!**/drizzle",
      "!**/next-env.d.ts"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "off",
          "options": {
            "allow": ["log"]
          }
        }
      },
      "style": {
        "useNamingConvention": "off",
        "noNonNullAssertion": "error",
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        "noForEach": "off"
      },
      "performance": {
        "noImgElement": "off"
      }
    }
  }
}
