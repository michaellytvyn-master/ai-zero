{
  "name": "zero-cost-ai",
  "private": true,
  "description": "One chat, one OpenAI-compatible API and a browser agent — over the free AI accounts you already own.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Michael Lytvyn",
  "keywords": [
    "ai",
    "llm",
    "byok",
    "chrome-extension",
    "nextjs",
    "openai-compatible",
    "groq",
    "gemini",
    "cloudflare-workers-ai"
  ],
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @zca/web dev",
    "build": "pnpm --filter @zca/web build",
    "dev:router": "vite-node scripts/dev-router.ts",
    "db:push": "pnpm --filter @zca/web db:push",
    "db:generate": "pnpm --filter @zca/web db:generate",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://localhost:5432/zca_dev} vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "icons": "node scripts/make-icons.mjs",
    "ext": "pnpm --filter @zca/extension build && node scripts/check-extension.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite-node": "^2.1.8",
    "vitest": "^2.1.8"
  }
}
